Index: bcm-linux-bde-modules/Kbuild
===================================================================
--- /dev/null
+++ bcm-linux-bde-modules/Kbuild
@@ -0,0 +1,17 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Compile every object with the installed kernel's configuration and ABI flags.
+obj-m += linux-kernel-bde.o linux-user-bde.o
+shared := systems/linux/kernel/modules/shared/gmodule.o systems/linux/kernel/modules/shared/ksal.o
+linux-kernel-bde-y := systems/bde/linux/kernel/linux-kernel-bde.o \
+ systems/bde/linux/kernel/linux_dma.o systems/bde/linux/kernel/linux_shbde.o \
+ systems/bde/linux/shared/mpool.o systems/bde/shared/shbde_pci.o \
+ systems/bde/shared/shbde_iproc.o systems/bde/shared/shbde_mdio.o $(shared)
+linux-user-bde-y := systems/bde/linux/user/kernel/linux-user-bde.o $(shared)
+ccflags-y += -I$(src)/include -I$(src)/systems \
+ -I$(src)/systems/linux/kernel/modules/include -I$(src)/systems/bde/linux/include \
+ -I$(src)/systems/bde/shared/include -DLINUX -DNO_FILEIO -DNO_CTRL_C -DNO_MEMTUNE \
+ -DLONGS_ARE_64BITS -DPTRS_ARE_64BITS -DSAL_SPL_LOCK_ON_IRQ \
+ -DBDE_LINUX_USE_MSIX_INTERRUPT -DBCM_PETRA_SUPPORT -D__DUNE_LINUX_BCM_CPU_PCIE__ \
+ -DBCM_DNX_SUPPORT -D_SIMPLE_MEMORY_ALLOCATION_=0 -DSAL_BDE_DMA_MEM_DEFAULT=32 \
+ -DSYS_BE_PIO=0 -DSYS_BE_PACKET=0 -DSYS_BE_OTHER=0 -DLE_HOST=1 \
+ -DBCM_PLATFORM_STRING=\"Vyatta\" -DBROADCOM_DEBUG
